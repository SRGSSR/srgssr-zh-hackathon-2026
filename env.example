# Copy to .env and fill in. Never commit .env.
# (Named env.example instead of .env.example only because of a local tooling rule; rename freely.)

# Public AI developer API key (https://platform.publicai.co). Only the ep-publicai relay uses it.
# Leave empty to run fully offline: the relay then answers with a clearly labelled SIMULATED response.
PUBLICAI_API_KEY=
SIMULATE_WITHOUT_KEY=1

# Gateway admin key (local only).
LITELLM_MASTER_KEY=sk-master-local-only

# API key of the fictional commune "Gemeinde Musterstadt". Its routing policy (CH-only) is bound
# to this key in gateway/communes.yaml, not to anything in the request.
MUSTERSTADT_API_KEY=sk-musterstadt-demo

# Test-only key that has no routing policy (every request must be rejected).
NOPOLICY_API_KEY=sk-nopolicy-test

# Shared secret between gateway (timeline events) and app.
INTERNAL_TOKEN=local-internal-token

# Max backoff (seconds) between retries of a waiting job.
RETRY_MAX_SECONDS=20
